<form name="form" method="post" action="{{ form_action }}">
   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
   <input type="hidden" name="plugin_tasklists_tasktypes_id" value="{{ tasktypes_id }}">

   <div class="card mb-3">
      <div class="card-header">
         <h4 class="card-title">{{ __('Add a group', 'tasklists') }}</h4>
      </div>
      <div class="card-body">
         <div class="row align-items-center">
            <label class="col-form-label col-sm-3">{{ __('Group') }}</label>
            <div class="col-sm-9">{{ groups_field|raw }}</div>
         </div>
      </div>
      <div class="card-footer text-center">
         <button type="submit" name="add_groups" class="btn btn-primary">{{ _x('button', 'Add') }}</button>
      </div>
   </div>
</form>
