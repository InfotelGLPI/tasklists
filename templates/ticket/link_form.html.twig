{# Link form of the task <-> ticket relation (Ticket::showForTicket() / showForTask()): one
   selector, pre-rendered by the core, and the submit button. #}
<div class="card mb-3">
    <form method="post" action="{{ action }}">
        <input type="hidden" name="{{ hidden_name }}" value="{{ hidden_value }}">
        <div class="card-header">
            <h3 class="card-title">{{ title }}</h3>
        </div>
        <div class="card-body d-flex flex-wrap align-items-center gap-2">
            <div class="flex-grow-1">{{ selector|raw }}</div>
            <button type="submit" name="{{ button_name }}" class="btn btn-primary">{{ button_label }}</button>
        </div>
    </form>
</div>
