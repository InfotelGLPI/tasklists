<tr class="tab_bg_1">
   <td>{{ __('Name') }}</td>
   <td>
      {{ name_field|raw }}
      {{ from_edit_ajax_field|raw }}
   </td>
   <td rowspan="4">{{ __('Description') }}</td>
   <td rowspan="4">{{ comment_field|raw }}</td>
</tr>

<tr class="tab_bg_1">
   <td>{{ __('Color') }}</td>
   <td>{{ color_field|raw }}</td>
</tr>

<tr class="tab_bg_1">
   <td>{{ __('Finished state') }}</td>
   <td>{{ finished_field|raw }}</td>
</tr>

{% if from_edit_ajax %}
   {{ tasktypes_hidden|raw }}
{% else %}
   <tr class="tab_bg_1">
      <td>{{ _n('Context', 'Contexts', 1, 'tasklists') }}</td>
      <td>
         {{ tasktypes_hidden|raw }}
         {{ tasktypes_field|raw }}
      </td>
   </tr>
{% endif %}
