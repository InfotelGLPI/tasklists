<form name="taskcomment_form{{ rand }}" id="taskcomment_form{{ rand }}"
      class="comment_form" method="post" action="{{ action }}">
   <table class="tab_cadre_fixe">
      <tr class="tab_bg_2">
         <th colspan="3">{{ is_edit ? __('Edit comment') : __('New comment') }}</th>
      </tr>
      <tr class="tab_bg_1">
         <td>
            <label for="comment">{{ __('Comment') }}</label>&nbsp;<span style="color:red">*</span>
         </td>
         <td>
            <textarea name="comment" id="comment" required="required">{{ content }}</textarea>
         </td>
         <td class="center">
            {% if is_edit %}
               <input type="submit" name="edit" value="{{ _x('button', 'Edit') }}" class="btn btn-primary">
            {% else %}
               <input type="submit" name="add" value="{{ _x('button', 'Add') }}" class="btn btn-primary">
            {% endif %}
            {% if is_edit or is_answer %}
               <input type="reset" name="cancel" value="{{ _x('button', 'Cancel') }}" class="btn btn-primary">
            {% endif %}

            <input type="hidden" name="plugin_tasklists_tasks_id" value="{{ plugin_tasklists_tasks_id }}">
            {% if lang is not null %}
               <input type="hidden" name="language" value="{{ lang }}">
            {% endif %}
            {% if is_answer %}
               <input type="hidden" name="parent_comment_id" value="{{ answer }}">
            {% endif %}
            {% if is_edit %}
               <input type="hidden" name="id" value="{{ edit }}">
            {% endif %}
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         </td>
      </tr>
   </table>
</form>
