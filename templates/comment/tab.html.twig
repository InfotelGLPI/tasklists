{% if cancomment %}
   <div class="firstbloc">
      {{ comment_form|raw }}
   </div>
{% endif %}

{% if number < 1 %}
   <div class="center">
      <table class="tab_cadre_fixe">
         <tr><th>{{ __('No comments') }}</th></tr>
      </table>
   </div>
{% else %}
   <div class="forcomments timeline_history" data-ajax-url="{{ ajax_url }}">
      <ul class="comments left">
         {{ comments_html|raw }}
      </ul>
   </div>
{% endif %}
