{% macro thread(comments, cancomment, level) %}
   {% import _self as self %}
   {% for comment in comments %}
      <li class="comment{{ level > 0 ? ' subcomment' : '' }}" id="taskcomment{{ comment.id }}">
         <div class="h_item left">
            {% if level == 0 %}<hr/>{% endif %}
            <div class="h_info">
               <div class="h_date">{{ comment.date_creation }}</div>
               <div class="h_user">
                  <a href="{{ comment.user_url }}">
                     <span class="avatar avatar-md rounded" style="{{ comment.avatar_style }}">
                        {%- if comment.user_initials is not empty %}{{ comment.user_initials }}{% endif -%}
                     </span>
                  </a>
               </div>
            </div>

            <div class="h_content ItilFollowup">
               <div class="displayed_content">
                  {% if cancomment and comment.can_edit %}
                     <span class="edit_item"
                           data-plugin_tasklists_tasks_id="{{ comment.plugin_tasklists_tasks_id }}"
                           data-lang="{{ comment.language }}"
                           data-id="{{ comment.id }}"></span>
                  {% endif %}
                  <div class="item_content">{{ comment.comment }}</div>
               </div>
               {% if cancomment %}
                  <span class="add_answer" title="{{ __('Add a comment') }}"
                        data-plugin_tasklists_tasks_id="{{ comment.plugin_tasklists_tasks_id }}"
                        data-lang="{{ comment.language }}"
                        data-id="{{ comment.id }}"></span>
               {% endif %}
            </div>
         </div>

         {% if comment.answers is not empty %}
            <input type="checkbox" id="toggle_{{ comment.id }}" class="toggle_comments" checked="checked">
            <label for="toggle_{{ comment.id }}" class="toggle_label">&nbsp;</label>
            <ul>{{ self.thread(comment.answers, cancomment, level + 1) }}</ul>
         {% endif %}
      </li>
   {% endfor %}
{% endmacro %}

{% import _self as self %}
{{ self.thread(comments, cancomment, 0) }}
