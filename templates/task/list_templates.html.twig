<div class="center">
   <table class="tab_cadre_fixe">
      <tr>
         <th colspan="{{ colspan }}">
            {{ add ? __('Choose a template', 'tasklists') : __('Templates') }} - {{ typename }}
         </th>
      </tr>

      {% if add %}
         <tr>
            <td colspan="{{ colspan }}" class="center tab_bg_1">
               <a href="{{ target }}?id=-1&withtemplate=2">&nbsp;&nbsp;&nbsp;{{ __('Blank Template') }}&nbsp;&nbsp;&nbsp;</a>
            </td>
         </tr>
      {% endif %}

      {% for tpl in templates %}
         <tr>
            <td class="center tab_bg_1">
               <a href="{{ target }}?id={{ tpl.id }}&withtemplate={{ add ? 2 : 1 }}">&nbsp;&nbsp;&nbsp;{{ tpl.name }}{% if tpl.show_id %}({{ tpl.id }}){% endif %}&nbsp;&nbsp;&nbsp;</a>
            </td>
            {% if multi_entities %}
               <td class="center tab_bg_2">{{ tpl.entity_name|raw }}</td>
            {% endif %}
            {% if not add %}
               <td class="center tab_bg_2">{{ tpl.delete_form|raw }}</td>
            {% endif %}
         </tr>
      {% endfor %}

      {% if not add %}
         <tr>
            <td colspan="{{ colspan }}" class="tab_bg_2 center">
               <b><a href="{{ target }}?withtemplate=1">{{ __('Add a template') }}</a></b>
            </td>
         </tr>
      {% endif %}
   </table>
</div>
